<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>وجه رسالة للمشرف دون الكشف عن هويتك</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: 'Tajawal', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between">

  <!-- Header -->
  <header class="border-b border-slate-200 bg-white shadow-xs sticky top-0 z-20">
    <div class="max-w-xl mx-auto px-4 py-3.5 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center font-bold text-lg">
          <i class="fa-solid fa-envelope-open-text"></i>
        </div>
        <div>
          <h1 class="font-bold text-sm sm:text-base text-slate-900">رسائل المشرف</h1>
          <p class="text-[11px] text-slate-500">سرية تامة بدون تسجيل دخول</p>
        </div>
      </div>
      
      <!-- Admin Toggle Button -->
      <button onclick="toggleAdminModal()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all border border-slate-200">
        <i class="fa-solid fa-user-shield text-amber-600"></i>
        <span>لوحة المشرف</span>
      </button>
    </div>
  </header>

  <!-- Main Section -->
  <main class="max-w-md mx-auto w-full px-4 py-8 flex-1 flex flex-col justify-center">
    
    <div class="text-center mb-6">
      <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 mb-2">وجه رسالة للمشرف دون الكشف عن هويتك</h2>
      <p class="text-slate-500 text-xs sm:text-sm">نحن هنا لسماع رأيك دائماً، شاركنا استفساراتك واقتراحاتك بكل حرية وراحة وبدون تسجيل بيانات.</p>
    </div>

    <!-- Form Box -->
    <div class="bg-white rounded-2xl p-5 sm:p-6 shadow-sm border border-slate-200/80">
      <form id="msgForm" onsubmit="sendMessage(event)">
        
        <label class="block text-xs font-bold text-slate-700 mb-2">نوع الرسالة:</label>
        <div class="grid grid-cols-4 gap-2 mb-4">
          <button type="button" onclick="selectCategory('كلمة طيبة')" class="cat-btn flex flex-col items-center justify-center p-2 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-700 hover:border-pink-400 hover:bg-pink-50/30 transition-all ring-2 ring-pink-400 bg-pink-50/30" data-cat="كلمة طيبة">
            <i class="fa-solid fa-heart text-pink-500 text-sm mb-1"></i>
            <span class="text-[10px] font-bold">كلمة طيبة</span>
          </button>
          <button type="button" onclick="selectCategory('استفسار')" class="cat-btn flex flex-col items-center justify-center p-2 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-700 hover:border-amber-400 hover:bg-amber-50/30 transition-all" data-cat="استفسار">
            <i class="fa-solid fa-circle-question text-amber-500 text-sm mb-1"></i>
            <span class="text-[10px] font-bold">استفسار</span>
          </button>
          <button type="button" onclick="selectCategory('اقتراح')" class="cat-btn flex flex-col items-center justify-center p-2 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-700 hover:border-emerald-400 hover:bg-emerald-50/30 transition-all" data-cat="اقتراح">
            <i class="fa-solid fa-lightbulb text-emerald-500 text-sm mb-1"></i>
            <span class="text-[10px] font-bold">اقتراح</span>
          </button>
          <button type="button" onclick="selectCategory('عام')" class="cat-btn flex flex-col items-center justify-center p-2 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-700 hover:border-blue-400 hover:bg-blue-50/30 transition-all" data-cat="عام">
            <i class="fa-solid fa-envelope text-blue-500 text-sm mb-1"></i>
            <span class="text-[10px] font-bold">عام</span>
          </button>
        </div>

        <!-- Textarea -->
        <div class="relative mb-4">
          <textarea id="msgContent" required maxlength="500" oninput="updateCounter()" placeholder="اكتب رسالتك هنا بكل مودة..." class="w-full h-32 p-3.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none text-sm resize-none bg-slate-50/50 text-slate-900 placeholder-slate-400"></textarea>
          <span id="charCounter" class="absolute bottom-2 left-3 text-[10px] text-slate-400 font-bold">0 / 500</span>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="w-full py-3 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-md shadow-amber-500/10 flex items-center justify-center gap-2 transition-all text-sm">
          <i class="fa-solid fa-paper-plane"></i>
          <span>إرسال الرسالة الآن</span>
        </button>
      </form>

      <!-- Alert Box -->
      <div id="alertBox" class="hidden mt-4 p-3 rounded-xl text-center text-xs font-bold transition-all"></div>
    </div>

  </main>

  <!-- Admin Passcode Modal -->
  <div id="adminModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white border border-slate-200 rounded-2xl p-6 w-full max-w-sm text-center shadow-xl relative">
      <button onclick="toggleAdminModal()" class="absolute top-3 left-3 text-slate-400 hover:text-slate-600 text-sm">
        <i class="fa-solid fa-xmark"></i>
      </button>
      <div class="w-12 h-12 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center mx-auto mb-3 border border-amber-100">
        <i class="fa-solid fa-lock text-lg"></i>
      </div>
      <h3 class="text-base font-bold text-slate-900 mb-1">دخول المشرف</h3>
      <p class="text-xs text-slate-500 mb-4">أدخل الرمز السري لعرض الرسائل المستقبلة</p>
      
      <input type="password" id="adminPass" placeholder="الرمز السري..." class="w-full text-center tracking-widest text-base py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 outline-none focus:border-amber-500 mb-4">
      
      <button onclick="checkAdminPass()" class="w-full py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl text-xs transition-all">
        تأكيد الدخول
      </button>
    </div>
  </div>

  <!-- Admin Panel View -->
  <div id="adminPanel" class="fixed inset-0 bg-slate-50 z-50 flex flex-col hidden overflow-y-auto">
    <div class="border-b border-slate-200 bg-white p-4 sticky top-0 z-20 flex items-center justify-between shadow-xs">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-600 flex items-center justify-center font-bold">
          <i class="fa-solid fa-shield-halved text-sm"></i>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-900">لوحة صندوق الرسائل</h2>
          <p class="text-[10px] text-slate-500">عرض الرسائل المُستقبلة</p>
        </div>
      </div>
      <button onclick="closeAdminPanel()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-bold border border-slate-200 flex items-center gap-1">
        <i class="fa-solid fa-right-from-bracket"></i>
        <span>خروج</span>
      </button>
    </div>

    <div class="max-w-lg mx-auto w-full p-4 flex-1">
      <div class="flex items-center justify-between mb-4 bg-white p-3 rounded-xl border border-slate-200 shadow-2xs">
        <span id="msgCount" class="text-xs font-bold text-slate-700">إجمالي الرسائل: 0</span>
        <button onclick="clearAllMsgs()" class="text-xs text-rose-600 hover:text-rose-700 font-bold flex items-center gap-1">
          <i class="fa-solid fa-trash"></i>
          <span>حذف الكل</span>
        </button>
      </div>

      <div id="messagesList" class="space-y-3">
        <!-- Messages rendered here -->
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="border-t border-slate-200 py-3 text-center text-[11px] text-slate-400 bg-white">
    جميع الرسائل سرية ومجهولة بالكامل
  </footer>

  <script>
    let selectedCat = 'كلمة طيبة';
    const ADMIN_CODE = "2910";

    function selectCategory(cat) {
      selectedCat = cat;
      document.querySelectorAll('.cat-btn').forEach(btn => {
        if(btn.dataset.cat === cat) {
          const colorClass = cat === 'كلمة طيبة' ? 'ring-pink-400 bg-pink-50/30' :
                             cat === 'استفسار' ? 'ring-amber-400 bg-amber-50/30' :
                             cat === 'اقتراح' ? 'ring-emerald-400 bg-emerald-50/30' : 'ring-blue-400 bg-blue-50/30';
          btn.className = `cat-btn flex flex-col items-center justify-center p-2 rounded-xl border border-slate-200 text-slate-700 transition-all ring-2 ${colorClass}`;
        } else {
          btn.className = "cat-btn flex flex-col items-center justify-center p-2 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-700 hover:border-slate-300 transition-all";
        }
      });
    }

    function updateCounter() {
      const val = document.getElementById('msgContent').value;
      document.getElementById('charCounter').innerText = `${val.length} / 500`;
    }

    function sendMessage(e) {
      e.preventDefault();
      const content = document.getElementById('msgContent').value.trim();
      if(!content) return;

      const newMsg = {
        id: Date.now(),
        category: selectedCat,
        text: content,
        date: new Date().toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit', hour12: true }) + ' - ' + new Date().toLocaleDateString('ar-EG')
      };

      const existing = JSON.parse(localStorage.getItem('clean_anon_messages') || '[]');
      existing.unshift(newMsg);
      localStorage.setItem('clean_anon_messages', JSON.stringify(existing));

      document.getElementById('msgContent').value = '';
      updateCounter();

      const alert = document.getElementById('alertBox');
      alert.className = "mt-4 p-3 rounded-xl text-center text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200 block";
      alert.innerHTML = '<i class="fa-solid fa-circle-check ml-1"></i> تم إرسال رسالتك بنجاح وسرية تامة. شكراً لك!';
      
      setTimeout(() => { alert.className = "hidden"; }, 4000);
    }

    function toggleAdminModal() {
      const modal = document.getElementById('adminModal');
      modal.classList.toggle('hidden');
      document.getElementById('adminPass').value = '';
    }

    function checkAdminPass() {
      const pass = document.getElementById('adminPass').value;
      if(pass === ADMIN_CODE) {
        toggleAdminModal();
        openAdminPanel();
      } else {
        alert('رمز الدخول غير صحيح!');
      }
    }

    function openAdminPanel() {
      document.getElementById('adminPanel').classList.remove('hidden');
      renderAdminMessages();
    }

    function closeAdminPanel() {
      document.getElementById('adminPanel').classList.add('hidden');
    }

    function renderAdminMessages() {
      const msgs = JSON.parse(localStorage.getItem('clean_anon_messages') || '[]');
      const container = document.getElementById('messagesList');
      document.getElementById('msgCount').innerText = `إجمالي الرسائل: ${msgs.length}`;

      if(msgs.length === 0) {
        container.innerHTML = `
          <div class="text-center py-16 text-slate-400">
            <i class="fa-solid fa-inbox text-3xl mb-2 opacity-40"></i>
            <p class="text-xs">لا توجد رسائل مُرسلة حتى الآن</p>
          </div>
        `;
        return;
      }

      container.innerHTML = msgs.map(m => `
        <div class="bg-white border border-slate-200 rounded-xl p-4 text-right shadow-2xs">
          <div class="flex items-center justify-between mb-2">
            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold ${
              m.category === 'كلمة طيبة' ? 'bg-pink-50 text-pink-700 border border-pink-200' :
              m.category === 'استفسار' ? 'bg-amber-50 text-amber-700 border border-amber-200' :
              m.category === 'اقتراح' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
              'bg-blue-50 text-blue-700 border border-blue-200'
            }">
              ${m.category}
            </span>
            <span class="text-[10px] text-slate-400">${m.date}</span>
          </div>
          <p class="text-slate-800 text-xs sm:text-sm whitespace-pre-wrap leading-relaxed">${m.text}</p>
          <div class="mt-3 pt-2 border-t border-slate-100 flex justify-end">
            <button onclick="deleteMsg(${m.id})" class="text-[11px] text-rose-600 hover:text-rose-700 flex items-center gap-1 font-semibold">
              <i class="fa-solid fa-trash-can"></i> حذف
            </button>
          </div>
        </div>
      `).join('');
    }

    function deleteMsg(id) {
      let msgs = JSON.parse(localStorage.getItem('clean_anon_messages') || '[]');
      msgs = msgs.filter(m => m.id !== id);
      localStorage.setItem('clean_anon_messages', JSON.stringify(msgs));
      renderAdminMessages();
    }

    function clearAllMsgs() {
      if(confirm('هل أنت متأكد من مسح جميع الرسائل؟')) {
        localStorage.removeItem('clean_anon_messages');
        renderAdminMessages();
      }
    }
  </script>
</body>
</html>
